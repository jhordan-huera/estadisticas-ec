# Copia este archivo como .env solo para uso local. Nunca lo subas al repositorio.
# En GitHub Actions estos valores van como secretos (IG_*) y variables de repositorio.

# Simulación activada por defecto. Solo "false" publica de verdad.
DRY_RUN=true

# Credenciales de Instagram (secretos)
IG_USER_ID=
IG_ACCESS_TOKEN=

# Base pública de las imágenes (la API de Instagram las descarga desde aquí)
# IMAGE_BASE_URL=https://raw.githubusercontent.com/<usuario>/<repo>/estado

# Rutas (opcionales)
# MARCADOR_DB=data/marcador.sqlite
# MARCADOR_MEDIA=out/posts
# MARCADOR_STATE_DIR=.
# MARCADOR_CACHE_DB=data/cache-http.sqlite

# TheSportsDB: "123" es la clave gratuita pública
# TSDB_API_KEY=123

# LOG_LEVEL=info
